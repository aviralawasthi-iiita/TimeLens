<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_order_fulfilment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="order_fulfilment" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Order placed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Authorise" name="Authorise card payment">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="Items in stock?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Backorder" name="Backorder from supplier">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Invoice" name="Create invoice">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Fraud" name="Review order for fraud">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Pick" name="Pick items">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Task_Supplier" name="Supplier ships missing items">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_NotifyDelay" name="Tell customer about the delay">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gateway_Backorder_join">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Inspect" name="Inspect supplier goods">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Stock_join">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Pack" name="Pack parcel">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Capture" name="Capture card payment">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Dest" name="Destination?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Label" name="Print domestic label">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Docs" name="Prepare export papers">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Domestic" name="Courier delivers parcel">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Customs" name="Prepare customs declaration">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Export" name="Screen export controls">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Docs_join" name="Export papers ready">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Ship" name="International carrier ships parcel">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Clearance" name="Clear import customs">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Dest_join">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Delivered" name="Parcel delivered">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_Delivered_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_Review" name="Ask customer for a review">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_1" name="Order closed">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Authorise" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Authorise" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Split" targetRef="Task_Invoice" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Split" targetRef="Task_Fraud" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Split" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Flow_6" name="In stock" sourceRef="Gateway_Stock" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_7" name="Out of stock" sourceRef="Gateway_Stock" targetRef="Gateway_Backorder" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Backorder" targetRef="Task_Supplier" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Backorder" targetRef="Task_NotifyDelay" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Supplier" targetRef="Gateway_Backorder_join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotifyDelay" targetRef="Gateway_Backorder_join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Backorder_join" targetRef="Task_Inspect" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Pick" targetRef="Gateway_Stock_join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Inspect" targetRef="Gateway_Stock_join" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Stock_join" targetRef="Task_Pack" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Invoice" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Fraud" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Pack" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Join" targetRef="Task_Capture" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Capture" targetRef="Gateway_Dest" />
    <bpmn:sequenceFlow id="Flow_21" name="Domestic" sourceRef="Gateway_Dest" targetRef="Task_Label" />
    <bpmn:sequenceFlow id="Flow_22" name="International" sourceRef="Gateway_Dest" targetRef="Gateway_Docs" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Label" targetRef="Task_Domestic" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Domestic" targetRef="Gateway_Dest_join" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_Docs" targetRef="Task_Customs" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_Docs" targetRef="Task_Export" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Customs" targetRef="Gateway_Docs_join" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Export" targetRef="Gateway_Docs_join" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_Docs_join" targetRef="Task_Ship" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_Ship" targetRef="Task_Clearance" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Clearance" targetRef="Gateway_Dest_join" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Gateway_Dest_join" targetRef="Event_Delivered" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Event_Delivered" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Review" targetRef="EndEvent_1" />
  </bpmn:process>
